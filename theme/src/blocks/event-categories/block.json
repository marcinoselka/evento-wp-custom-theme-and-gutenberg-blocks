{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "evento/event-categories",
	"title": "EVENTO Event Categories",
	"category": "widgets",
	"icon": "category",
	"description": "Displays EVENTO event categories with event counts, linking to their archives.",
	"textdomain": "evento-cbt",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
