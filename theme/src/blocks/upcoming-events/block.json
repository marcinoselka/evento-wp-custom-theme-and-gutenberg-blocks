{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "evento/upcoming-events",
	"title": "EVENTO Upcoming Events",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Displays a grid of upcoming EVENTO events, ordered by start date.",
	"textdomain": "evento-cbt",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
