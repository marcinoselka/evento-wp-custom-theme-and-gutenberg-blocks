{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif",
          "slug": "sans",
          "name": "Manrope"
        },
        {
          "fontFamily": "'Unbounded', sans-serif",
          "slug": "display",
          "name": "Unbounded"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1.0625rem", "name": "Medium" },
        { "slug": "large", "size": "1.5rem", "name": "Large" },
        { "slug": "x-large", "size": "2.25rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "3.25rem", "name": "Huge" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "color": {
      "palette": [
        { "slug": "stone-bg", "color": "#F2F1EC", "name": "Stone Background" },
        { "slug": "stone-surface", "color": "#FFFFFF", "name": "Stone Surface" },
        { "slug": "stone-line", "color": "#E4E2D8", "name": "Stone Line" },
        { "slug": "ink", "color": "#1E2420", "name": "Ink" },
        { "slug": "ink-soft", "color": "#4B534E", "name": "Ink Soft" },
        { "slug": "park", "color": "#3E7A4C", "name": "Park" },
        { "slug": "park-dark", "color": "#2E5C39", "name": "Park Dark" },
        { "slug": "park-light", "color": "#E7F0E9", "name": "Park Light" },
        { "slug": "sky", "color": "#4A90D9", "name": "Sky" },
        { "slug": "sky-dark", "color": "#356FAE", "name": "Sky Dark" },
        { "slug": "sky-light", "color": "#E9F2FB", "name": "Sky Light" },
        { "slug": "sun", "color": "#E8B33D", "name": "Sun" },
        { "slug": "sun-dark", "color": "#C6921F", "name": "Sun Dark" },
        { "slug": "sun-light", "color": "#FBF1DC", "name": "Sun Light" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--stone-bg)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--park-dark)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--park)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.7em",
            "bottom": "0.7em",
            "left": "1.4em",
            "right": "1.4em"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--park-dark)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "800",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "EVENTO Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "EVENTO Footer"
    }
  ]
}
